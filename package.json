{
  "name": "qa_pw_intro",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "dependencies": {
    "@faker-js/faker": "^9",
    "playwright-core": "^1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1",
    "@types/node": "^22.10.5",
    "allure-commandline": "^2.32.1",
    "allure-playwright": "^3.2.0",
    "eslint": "^9.19.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  },
  "scripts": {
    "prepare": "husky",
    "pretest": "rimraf allure-results",
    "test": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "pretest:auth": "rimraf allure-results",
    "test:auth": "npx playwright test tests/auth",
    "pretest:account": "rimraf allure-results",
    "test:account": "npx playwright test tests/accountServices",
    "pretest:positive": "rimraf allure-results",
    "test:positive": "npx playwright test --grep @positive",
    "pretest:negative": "rimraf allure-results",
    "test:negative": "npx playwright test --grep @negative",
    "pretest:critical": "rimraf allure-results",
    "test:critical": "npx playwright test --grep-severity critical",
    "report:allure:serve": "allure serve ./allure-results",
    "report:allure:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:allure:open": "allure open ./allure-report",
    "report:playwright": "npx playwright show-report",
    "clean:allure": "rimraf allure-results allure-report",
    "clean:playwright": "rimraf playwright-report test-results"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{js,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
